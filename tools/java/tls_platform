    // ═══════════════════════════════════════════════════════════════════
    //  SECTION 1 — ADD / REMOVE / SEARCH / ITERATE
    //  These four are what your teacher is specifically looking for
    // ═══════════════════════════════════════════════════════════════════

    /** ADD — append a firm to the list */
    static void addFirm(Startup s) {
        firms.add(s);
        System.out.println("✓ Added: " + s.name + " (total: " + firms.size() + " firms)");
    }

    /** REMOVE — find by name and remove using Iterator (safe mid-loop removal) */
    static boolean removeFirm(String name) {
        Iterator<Startup> it = firms.iterator();
        while (it.hasNext()) {
            Startup s = it.next();
            if (s.name.equalsIgnoreCase(name)) {
                it.remove();   // <-- Iterator.remove(), not list.remove() inside a loop
                System.out.println("✓ Removed: " + name + " (total: " + firms.size() + " firms)");
                return true;
            }
        }
        System.out.println("✗ Not found: " + name);
        return false;
    }

    /** SEARCH — find and return one firm by name (null if not found) */
    static Startup searchByName(String name) {
        for (Startup s : firms) {            // for-each = iteration
            if (s.name.equalsIgnoreCase(name)) return s;
        }
        return null;
    }

    /** SEARCH — return a filtered ArrayList by industry */
    static ArrayList<Startup> searchByIndustry(String industry) {
        ArrayList<Startup> results = new ArrayList<>();
        for (Startup s : firms) {
            if (s.industry.equalsIgnoreCase(industry)) results.add(s);
        }
        return results;
    }

    /** SEARCH — return firms above a minimum TLS v2 threshold */
    static ArrayList<Startup> searchByMinTLS(double minTLS) {
        ArrayList<Startup> results = new ArrayList<>();
        for (Startup s : firms) {
            if (s.tlsV2() >= minTLS) results.add(s);
        }
        return results;
    }

    /** SEARCH — return YC-backed firms only */
    static ArrayList<Startup> searchYC() {
        ArrayList<Startup> results = new ArrayList<>();
        for (Startup s : firms) {
            if (!s.ycBatch.equalsIgnoreCase("n/a")) results.add(s);
        }
        return results;
    }

    /** ITERATE — print every firm in the list (basic iteration) */
    static void printAll() {
        System.out.println("\n── All " + firms.size() + " firms ──────────────────────────────────");
        for (Startup s : firms) {
            System.out.println(s);   // calls Startup.toString()
        }
        System.out.println();
    }

    /** ITERATE — print a specific ArrayList (reusable for filtered results) */
    static void printList(ArrayList<Startup> list, String label) {
        System.out.println("\n── " + label + " (" + list.size() + " firms) ────────────────────────");
        if (list.isEmpty()) { System.out.println("  (no results)"); return; }
        for (Startup s : list) System.out.println(s);
        System.out.println();
    }

    // ═══════════════════════════════════════════════════════════════════
    //  SECTION 2 — SORT  (Collections.sort with Comparator)
    // ═══════════════════════════════════════════════════════════════════

    static void sortByTLSv2()    { Collections.sort(firms, Comparator.comparingDouble(s -> -s.tlsV2())); }
    static void sortByGrowth()   { Collections.sort(firms, Comparator.comparingInt(s -> -s.growthRate)); }
    static void sortByEmployees(){ Collections.sort(firms, Comparator.comparingInt(s -> s.employees)); }
    static void sortByName()     { Collections.sort(firms, Comparator.comparing(s -> s.name)); }
    static void sortByROI()      { Collections.sort(firms, Comparator.comparingDouble(s -> -s.roiProxy())); }

    // ═══════════════════════════════════════════════════════════════════
    //  SECTION 3 — STATISTICS  (uses iteration over the ArrayList)
    // ═══════════════════════════════════════════════════════════════════

    static void printStats() {
        double sumV1 = 0, sumV2 = 0, sumEmp = 0, sumGrowth = 0;
        double minV2 = Double.MAX_VALUE, maxV2 = Double.MIN_VALUE;
        Startup topFirm = null;

        for (Startup s : firms) {          // iterate to accumulate
            sumV1    += s.tlsV1();
            sumV2    += s.tlsV2();
            sumEmp   += s.employees;
            sumGrowth+= s.growthRate;
            if (s.tlsV2() > maxV2) { maxV2 = s.tlsV2(); topFirm = s; }
            if (s.tlsV2() < minV2)   minV2 = s.tlsV2();
        }

        int n = firms.size();
        System.out.println("\n╔══════════════════════════════════════════════╗");
        System.out.println("║           STATISTICS DASHBOARD               ║");
        System.out.println("╠══════════════════════════════════════════════╣");
        System.out.printf( "║  Firms in database:  %-24d║%n", n);
        System.out.printf( "║  Mean TLS v1:        %-24.1f║%n", sumV1/n);
        System.out.printf( "║  Mean TLS v2:        %-24.1f║%n", sumV2/n);
        System.out.printf( "║  Min  TLS v2:        %-24.1f║%n", minV2);
        System.out.printf( "║  Max  TLS v2:        %-24.1f║%n", maxV2);
        System.out.printf( "║  Mean employees:     %-24.0f║%n", sumEmp/n);
        System.out.printf( "║  Mean growth:        %-23.0f%%║%n", sumGrowth/n);
        System.out.printf( "║  Top firm (TLS v2):  %-24s║%n",
            topFirm != null ? topFirm.name : "—");
        System.out.println("╚══════════════════════════════════════════════╝\n");
    }

    // ═══════════════════════════════════════════════════════════════════
    //  SECTION 4 — RANKED TABLE  (sort then iterate)
    // ═══════════════════════════════════════════════════════════════════

    static void printRankedTable(int topN) {
        sortByTLSv2();
        System.out.println("\n Rank │ Company              │ Industry   │  Emp │ TLS v1 │ TLS v2 │ Growth");
        System.out.println("──────┼──────────────────────┼────────────┼──────┼────────┼────────┼───────");
        int rank = 1;
        for (Startup s : firms) {         // iterate in sorted order
            if (rank > topN) break;
            String medal = rank == 1 ? " 🥇" : rank == 2 ? " 🥈" : rank == 3 ? " 🥉" : String.format("%3d ", rank);
            System.out.printf("%s │ %-20s │ %-10s │ %4d │%7.0f │%7.0f │ %3d%%%n",
                medal,
                s.name.length() > 20 ? s.name.substring(0, 19) + "…" : s.name,
                s.industry,
                s.employees,
                s.tlsV1(), s.tlsV2(),
                s.growthRate);
            rank++;
        }
        System.out.println();
    }

    // ═══════════════════════════════════════════════════════════════════
    //  SECTION 5 — UPDATE  (search + mutate)
    // ═══════════════════════════════════════════════════════════════════

    static void updateEmployees(String name, int newCount) {
        Startup s = searchByName(name);
        if (s == null) { System.out.println("Not found: " + name); return; }
        s.employees  = newCount;
        s.laborHours = newCount * 2080.0;
        System.out.printf("✓ Updated %s → %d employees (new TLS v2: %.1f)%n",
            name, newCount, s.tlsV2());
    }

    static void updateGrowth(String name, int newGrowth) {
        Startup s = searchByName(name);
        if (s == null) { System.out.println("Not found: " + name); return; }
        s.growthRate = newGrowth;
        System.out.printf("✓ Updated %s → %d%% growth (new TLS v2: %.1f)%n",
            name, newGrowth, s.tlsV2());
    }

