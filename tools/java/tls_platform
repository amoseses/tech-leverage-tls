import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;
import java.util.Iterator;

public class TLSCollector {

    static class Firm {
        String name;
        String industry;
        int    founded;
        int    employees;
        String revenueRange;
        String fundingStage;
        String techToolsList;
        double annualTechSpend;
        double totalQuarterlyLaborHrs;
        int    growthRate;
        String ycBatch;
        String country;

        Firm(String name, String industry, int founded, int employees,
             String revenueRange, String fundingStage, String techToolsList,
             double annualTechSpend, double totalQuarterlyLaborHrs,
             int growthRate, String ycBatch, String country) {
            this.name=name; this.industry=industry; this.founded=founded;
            this.employees=employees; this.revenueRange=revenueRange;
            this.fundingStage=fundingStage; this.techToolsList=techToolsList;
            this.annualTechSpend=annualTechSpend;
            this.totalQuarterlyLaborHrs=totalQuarterlyLaborHrs;
            this.growthRate=growthRate; this.ycBatch=ycBatch; this.country=country;
        }

        int nTools() {
            if (techToolsList==null||techToolsList.isBlank()) return 0;
            int c=0; for(String t:techToolsList.split(",")) if(!t.strip().isEmpty()) c++;
            return c;
        }
        double laborHoursAnnual() { return totalQuarterlyLaborHrs*4; }
        double tlsV1() { double h=laborHoursAnnual(); return h==0?0:1000.0*annualTechSpend/h; }
        double tlsV2() {
            double ai=1.0+Math.min(nTools(),5)*0.04;
            double gr=1.0+Math.min(growthRate,100)/100.0*0.15;
            return tlsV1()*1.0*ai*gr;
        }
        double roiProxy() { return tlsV2()*(1.0+growthRate/100.0); }

        public String toString() {
            return String.format("%-22s | %-10s | %4d | %5d emp | %-12s | TLS v2: %7.1f | Growth: %3d%%",
                name,industry,founded,employees,fundingStage,tlsV2(),growthRate);
        }
        void printCard() {
            System.out.println("-".repeat(72));
            System.out.printf("  %s  (%s)  Founded: %d  %s%n",name,industry,founded,country);
            System.out.printf("  %d FTE | %s | %s | YC: %s%n",employees,revenueRange,fundingStage,ycBatch);
            System.out.printf("  Tools: %s [%d]%n",techToolsList,nTools());
            System.out.printf("  TLS v1: %.2f  TLS v2: %.2f  ROI: %.2f%n",tlsV1(),tlsV2(),roiProxy());
            System.out.println("-".repeat(72));
        }
    }

    static ArrayList<Firm> firms = new ArrayList<>();

    static void addFirm(Firm f) { firms.add(f); System.out.println("Added: "+f.name+" (total: "+firms.size()+")");}
    static boolean removeFirm(String name) {
        Iterator<Firm> it=firms.iterator();
        while(it.hasNext()){Firm f=it.next();if(f.name.equalsIgnoreCase(name)){it.remove();System.out.println("Removed: "+name+" (total: "+firms.size()+")");return true;}}
        System.out.println("Not found: "+name); return false;
    }
    static Firm searchByName(String name) { for(Firm f:firms) if(f.name.equalsIgnoreCase(name)) return f; return null; }
    static ArrayList<Firm> searchByIndustry(String ind) { ArrayList<Firm> r=new ArrayList<>(); for(Firm f:firms) if(f.industry.equalsIgnoreCase(ind)) r.add(f); return r; }
    static ArrayList<Firm> searchYC() { ArrayList<Firm> r=new ArrayList<>(); for(Firm f:firms) if(!f.ycBatch.equalsIgnoreCase("n/a")) r.add(f); return r; }
    static void printAll() { System.out.println("\n-- All "+firms.size()+" firms --"); for(Firm f:firms) System.out.println(f); System.out.println(); }
    static void printList(ArrayList<Firm> list, String label) {
        System.out.println("\n-- "+label+" ("+list.size()+" firms) --");
        if(list.isEmpty()){System.out.println("  (no results)");return;}
        for(Firm f:list) System.out.println(f); System.out.println();
    }
    static void sortByTLSv2() { Collections.sort(firms,Comparator.comparingDouble(f->-f.tlsV2())); }
    static void printStats() {
        double sv1=0,sv2=0,maxV2=-1; Firm top=null;
        for(Firm f:firms){sv1+=f.tlsV1();sv2+=f.tlsV2();if(f.tlsV2()>maxV2){maxV2=f.tlsV2();top=f;}}
        int n=firms.size();
        System.out.println("\n+-------------------------------------+");
        System.out.println("|       STATISTICS DASHBOARD          |");
        System.out.println("+-------------------------------------+");
        System.out.printf("|  Firms:        %-21d|%n",n);
        System.out.printf("|  Mean TLS v1:  %-21.1f|%n",sv1/n);
        System.out.printf("|  Mean TLS v2:  %-21.1f|%n",sv2/n);
        System.out.printf("|  Top firm:     %-21s|%n",top!=null?top.name:"--");
        System.out.println("+-------------------------------------+\n");
    }
    static void printRanked(int topN) {
        sortByTLSv2();
        System.out.println(" # | Company              | Industry   | TLS v2  | Growth");
        System.out.println("---+----------------------+------------+---------+-------");
        int rank=1;
        for(Firm f:firms){
            if(rank>topN) break;
            System.out.printf("%2d | %-20s | %-10s | %7.1f | %3d%%%n",rank++,
                f.name.length()>20?f.name.substring(0,19)+"~":f.name,f.industry,f.tlsV2(),f.growthRate);
        }
        System.out.println();
    }

